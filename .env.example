# Example environment file for swglogin
# Copy this to .env and fill in your values
# The app will automatically load these on startup if python-dotenv is installed

# Flask configuration
FLASK_SECRET_KEY=replace-with-a-strong-random-secret

# Database configuration
DB_HOST=127.0.0.1
DB_NAME=swgusers
DB_USER=swg
DB_PASS=replace-with-a-strong-db-password

# Logging configuration
LOG_MAX_MB=10             # 10MB (in bytes)
LOG_BACKUP_COUNT=10       # Keep 10 rotated log files
