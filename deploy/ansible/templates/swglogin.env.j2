# /etc/default/swglogin (managed by Ansible)
# Keep this file readable by root and the service group only.

VENV_PATH={{ venv_path }}
FLASK_SECRET_KEY='{{ flask_secret_key }}'
DB_HOST='{{ db_host }}'
DB_NAME='{{ db_name }}'
DB_USER='{{ db_user }}'
DB_PASS='{{ db_pass }}'
# Application logging controls
LOG_LEVEL='{{ log_level | default("ERROR") }}'           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MAX_MB='{{ log_max_mb | default(10) }}'
LOG_BACKUP_COUNT='{{ log_backup_count | default(10) }}'
