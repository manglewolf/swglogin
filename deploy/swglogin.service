[Unit]
Description=SWG Login Frontend (Flask) - swglogin
After=network.target

[Service]
Type=simple
# User and group the service should run as (adjust as needed)
User=www-data
Group=www-data

# Directory where the application resides
WorkingDirectory=/srv/swglogin

# Load environment variables from this file (optional). Create /etc/default/swglogin
# with DB_HOST, DB_NAME, DB_USER, DB_PASS, FLASK_SECRET_KEY, etc.
EnvironmentFile=-/etc/default/swglogin

# Use deployment script which handles virtualenv activation, logging and tunables.
# The script consults APP_DIR, VENV_PATH, WORKERS, BIND_ADDRESS, etc. (see deploy/run_gunicorn.sh)
# Ensure the script is present at /srv/swglogin/deploy/run_gunicorn.sh and executable (chmod +x).
ExecStart=/srv/swglogin/deploy/run_gunicorn.sh

# Auto-restart on failure
Restart=always
RestartSec=5s

# Logs
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=swglogin

[Install]
WantedBy=multi-user.target
